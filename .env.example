# Personal secrets only — copy to .env.local (never commit).
# Local Supabase + Mailpit: automatic via .env.development + `npm run dev` (see ENV.md).
# Hosted Supabase (scripts / production): .env.hosted.local or deployment dashboard — not here.

OPENAI_API_KEY=
TMDB_API_KEY=
YOUTUBE_API_KEY=
CRON_SECRET=

# Weekly film import report (Resend). See WEEKLY_FILM_IMPORT.md.
# RESEND_API_KEY=
# WEEKLY_FILM_IMPORT_REPORT_EMAIL=
# WEEKLY_FILM_IMPORT_EMAIL_FROM=
# WEEKLY_FILM_IMPORT_BATCH_SIZE=5
# WEEKLY_FILM_IMPORT_STALE_MINUTES=90
# WEEKLY_FILM_IMPORT_LOW_QUEUE_THRESHOLD=7

# Weekly film discovery (Resend). Falls back to WEEKLY_FILM_IMPORT_REPORT_EMAIL.
# See WEEKLY_FILM_DISCOVERY.md. Keep ENABLED unset until reviewed.
# WEEKLY_FILM_DISCOVERY_ENABLED=
# WEEKLY_FILM_DISCOVERY_REPORT_EMAIL=
# WEEKLY_FILM_DISCOVERY_EMAIL_FROM=
# WEEKLY_FILM_DISCOVERY_SEED_CONFIRM=
# WEEKLY_FILM_DISCOVERY_MEDIA_CONFIRM=
# WEEKLY_FILM_DISCOVERY_CONTENT_CONFIRM=

# Server-only Supabase auth user UUID allowed to use /admin and admin APIs.
# Never use NEXT_PUBLIC_* for this. If unset, admin access is denied.
ADMIN_USER_ID=

# Optional canonical site URL override (default for dev is in .env.development)
# NEXT_PUBLIC_SITE_URL=

# Comma-separated OAuth providers on /login (e.g. apple,google).
# Omit or leave unset to hide OAuth until provider credentials are ready.
# NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=apple,google
