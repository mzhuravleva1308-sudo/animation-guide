{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://animationpre.local/schemas/film-discovery-minimal-batch.schema.json",
  "title": "Resonale film discovery minimal seed batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_name", "films"],
  "properties": {
    "batch_name": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "films": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/film"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "film": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "year",
        "directors",
        "countries",
        "runtime_minutes"
      ],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "original_title": {
          "anyOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 1888,
          "maximum": 2100
        },
        "directors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "countries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "runtime_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
