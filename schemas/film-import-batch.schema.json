{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://animationpre.local/schemas/film-import-batch.schema.json",
  "title": "AnimationPre film import batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_name", "films"],
  "properties": {
    "batch_name": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "films": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/film"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "urlOrNull": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "film": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "year",
        "countries",
        "directors",
        "synopsis",
        "the_mood",
        "technique",
        "festival_recognitions",
        "source_urls"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "original_title": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 1888,
          "maximum": 2100
        },
        "runtime_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "countries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "directors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "synopsis": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "the_mood": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "technique": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "festival_recognitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/festivalRecognition"
          }
        },
        "source_urls": {
          "$ref": "#/$defs/sourceUrls"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "festivalRecognition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "festival_name",
        "festival_year",
        "recognition_type",
        "source_url"
      ],
      "properties": {
        "festival_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "festival_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "recognition_type": {
          "enum": ["selection", "nomination", "award"]
        },
        "award_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "award_result": {
          "enum": ["winner", "nominee", "jury_prize", "grand_prize", "mention", null]
        },
        "award_level": {
          "enum": ["grand_prize", "jury_prize", "category_award", "mention", null]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recognition_type": {
                "const": "award"
              }
            },
            "required": ["recognition_type"]
          },
          "then": {
            "required": ["award_name"],
            "properties": {
              "award_name": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "sourceUrls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official", "festival", "tmdb", "imdb"],
      "properties": {
        "official": {
          "$ref": "#/$defs/urlOrNull"
        },
        "festival": {
          "$ref": "#/$defs/urlOrNull"
        },
        "tmdb": {
          "$ref": "#/$defs/urlOrNull"
        },
        "imdb": {
          "$ref": "#/$defs/urlOrNull"
        }
      },
      "anyOf": [
        {
          "properties": {
            "official": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "festival": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "tmdb": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "imdb": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
