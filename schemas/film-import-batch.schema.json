{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://animationpre.local/schemas/film-import-batch.schema.json",
  "title": "AnimationPre film import batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_name", "films"],
  "properties": {
    "batch_name": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "films": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/film"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "urlOrNull": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "film": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "year",
        "countries",
        "directors",
        "synopsis",
        "the_mood",
        "technique",
        "festival_recognitions",
        "source_urls",
        "quick_filters"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "original_title": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 1888,
          "maximum": 2100
        },
        "runtime_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "countries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "directors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "synopsis": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "the_mood": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "technique": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "festival_recognitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/festivalRecognition"
          }
        },
        "source_urls": {
          "$ref": "#/$defs/sourceUrls"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "quick_filters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["sci-fi", "sarcasm", "connection", "distance", "landscapes"]
          },
          "not": {
            "allOf": [
              {
                "contains": {
                  "const": "connection"
                }
              },
              {
                "contains": {
                  "const": "distance"
                }
              }
            ]
          },
          "description": "Manual quick filters written to films.quick_filters. sarcasm = dry irony / cynicism / caustic black humor (not mere absurd or quirky comedy). connection = Light (emotional closeness); distance = Shadow (detachment). Omit both tonal tokens when the film is in the middle. connection and distance are mutually exclusive; sci-fi and sarcasm may combine with either tonal token or stand alone."
        },
        "catalog_visible": {
          "type": "boolean",
          "description": "When false, the film is soft-hidden from the public catalog. Defaults to true when omitted."
        },
        "origin": {
          "type": "string",
          "enum": ["discovery_release", "manual"],
          "description": "Import origin. discovery_release defers profile score rebuild until batch Go Live."
        },
        "discovery_candidate_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
          "description": "Staging film_discovery_candidates.id when origin is discovery_release."
        },
        "moods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "description": "Pre-filled emotional tags. When present, fill-emotional-tags is skipped."
        },
        "aesthetic_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "description": "Pre-filled material/aesthetic tags. When present, fill-aesthetic-tags is skipped."
        },
        "image_url": {
          "$ref": "#/$defs/urlOrNull",
          "description": "External poster URL to seed films.image_url. Leave films.poster_url empty so cache-posters writes Storage."
        },
        "external_image_url": {
          "$ref": "#/$defs/urlOrNull"
        },
        "trailer_url": {
          "$ref": "#/$defs/urlOrNull"
        },
        "trailer_provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "trailer_video_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "trailer_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "festivalRecognition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "festival_name",
        "festival_year",
        "recognition_type",
        "source_url"
      ],
      "properties": {
        "festival_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "festival_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "recognition_type": {
          "enum": ["selection", "nomination", "award"]
        },
        "award_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "award_result": {
          "enum": ["winner", "nominee", "jury_prize", "grand_prize", "mention", null]
        },
        "award_level": {
          "enum": ["grand_prize", "jury_prize", "category_award", "mention", null]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recognition_type": {
                "const": "award"
              }
            },
            "required": ["recognition_type"]
          },
          "then": {
            "required": ["award_name"],
            "properties": {
              "award_name": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "sourceUrls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official", "festival", "tmdb", "imdb"],
      "properties": {
        "official": {
          "$ref": "#/$defs/urlOrNull"
        },
        "festival": {
          "$ref": "#/$defs/urlOrNull"
        },
        "tmdb": {
          "$ref": "#/$defs/urlOrNull"
        },
        "imdb": {
          "$ref": "#/$defs/urlOrNull"
        }
      },
      "anyOf": [
        {
          "properties": {
            "official": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "festival": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "tmdb": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "imdb": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
